# Copy to .env and fill in.

DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/redvyn?schema=public"


# Two distinct 32-byte keys, hex. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# PHONE_ENC_KEY encrypts the number at rest, PHONE_HASH_KEY produces the lookup
# index. They must not be the same value.
PHONE_ENC_KEY=""
PHONE_HASH_KEY=""

# JWT signing secret. Must be a strong, unguessable string.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""
JWT_TTL="12h"

# First admin user created by prisma/seed.ts. Existing users are never overwritten.
ADMIN_EMAIL="admin@redvyn.local"
ADMIN_SEED_PASSWORD="change-me"

SESSION_SECRET="change-me-too"

# Escalation scheduler interval (milliseconds). Default 60s. Handles offer timeouts and
# lineup exhaustion. Set to 0 to disable the scheduler.
SWEEP_INTERVAL_MS=60000

PORT=4000
BASE_URL="http://localhost:4000"
FRONTEND_URL="http://localhost:3000"
NODE_ENV=development
